# Copy to `.env`. The values below match docker-compose.yml, so on a machine
# running `docker compose up -d` this file works unchanged.
#
# 127.0.0.1 rather than `localhost`, deliberately: Compose binds the port to
# the IPv4 loopback only, and on Windows `localhost` resolves to ::1 first,
# which stalls the connection until it times out before retrying IPv4.
#
# PostgreSQL is the database this project targets. app/config.py still falls
# back to a local SQLite file if DATABASE_URL is unset, so that the app can
# boot without a live database - that fallback is for emergencies and for the
# test suite, not for real work.
# The password must match the repository-root .env that docker-compose.yml reads.
DATABASE_URL=postgresql+psycopg://buktiesg:CHANGE_ME@127.0.0.1:5432/buktiesg

# Optional. Without it `build_extractor` returns NullExtractor and the system
# behaves exactly as it did before value extraction existed - documents store
# and index, values stay absent, questions read PARTIAL. That is what makes
# introducing a model reversible, and it is why CI sets no key: the fallback
# path is the one CI exercises, at no cost and with no external dependency.
#
# DEEPSEEK_API_KEY=sk-...
